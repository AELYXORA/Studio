{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AELYXORA Win64 deterministic build input candidate",
  "description": "Proposed input manifest only, cannot confer execution approval and contains no trusted output SHA or approval status. Exact semantic/target/toolchain validation beyond shape required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "profile",
    "projectId",
    "snapshotDigest",
    "semanticGraphDigest",
    "lockFileDigest",
    "coreRegistryFingerprint",
    "targetTriple",
    "abiLayoutDigest",
    "workingRoot",
    "buildMode",
    "inputs",
    "tools",
    "environment",
    "outputs"
  ],
  "properties": {
    "format": {
      "const": "aui.win64-build-inputs"
    },
    "profile": {
      "const": "1-draft"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "snapshotDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticGraphDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lockFileDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coreRegistryFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetTriple": {
      "const": "x86_64-pc-windows-msvc"
    },
    "abiLayoutDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workingRoot": {
      "const": "/workspace"
    },
    "buildMode": {
      "enum": [
        "debug",
        "release"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "category"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "category": {
            "enum": [
              "asm",
              "aui",
              "source",
              "header",
              "resource",
              "layout",
              "link-script",
              "generated"
            ]
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "toolId",
          "toolSha256",
          "version",
          "arguments"
        ],
        "properties": {
          "toolId": {
            "enum": [
              "assembler",
              "linker",
              "resource-compiler",
              "generator",
              "debug-symbol-writer"
            ]
          },
          "toolSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value"
        ],
        "properties": {
          "name": {
            "enum": [
              "TZ",
              "LC_ALL",
              "SOURCE_DATE_EPOCH",
              "TEMP_ROOT"
            ]
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "kind": {
            "enum": [
              "unsigned-pe",
              "pdb",
              "resource-output"
            ]
          }
        }
      }
    }
  }
}

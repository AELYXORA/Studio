{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AELYXORA — source-only AUI compilation diagnostics design envelope",
  "description": "Proposed closed failure envelope only after exact source was successfully captured, not a completed compiler or a signed Graph. CLI errors before source capture may use a separate future transport contract. The schema cannot validate actual byte-span containment or source SHA.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "mode",
    "profile",
    "source",
    "catalog",
    "exitCode",
    "diagnostics"
  ],
  "properties": {
    "format": {
      "const": "aui.compiler-source-only-diagnostics"
    },
    "status": {
      "const": "ERROR"
    },
    "mode": {
      "enum": [
        "check",
        "emit-plan"
      ]
    },
    "profile": {
      "enum": [
        "l0",
        "l1"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "byteLength"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sourceFormat",
        "sourceIdentity",
        "sha256"
      ],
      "properties": {
        "status": {
          "const": "UNVERIFIED"
        },
        "sourceFormat": {
          "const": "aui.compiler-source-only-review-catalog"
        },
        "sourceIdentity": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of exact original UTF-8 review-type-catalog bytes; identity only, not verified public exports"
        }
      }
    },
    "exitCode": {
      "enum": [
        1,
        3,
        5
      ]
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 101,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "stage",
          "severity",
          "sourceFile",
          "sourceSha256",
          "startByte",
          "endByte",
          "messageKey",
          "expected",
          "actual"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^AUI_[A-Z0-9_]+$"
          },
          "stage": {
            "enum": [
              "P01",
              "P02",
              "P03",
              "P04",
              "P05",
              "P06"
            ]
          },
          "severity": {
            "const": "error"
          },
          "sourceFile": {
            "type": "string",
            "minLength": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "startByte": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "endByte": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "messageKey": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "expected": {
            "type": "string",
            "maxLength": 1024
          },
          "actual": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AUI Project Manifest — proposed",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "revision",
    "targets",
    "packageDependencies",
    "nodes",
    "edges"
  ],
  "properties": {
    "format": {
      "const": "aui.project"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "triple",
          "execution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "triple": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "packageDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "packageId",
          "version"
        ],
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "typeRef": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "direction",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "Structural format accepts nonempty edge-kind tokens; D2 semantic registry validates known kinds and emits GRAPH_EDGE_KIND_UNKNOWN."
          },
          "from": {
            "type": "object",
            "required": [
              "node"
            ],
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "required": [
              "node"
            ],
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "dataFlows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "channels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "edgeId",
                "mode",
                "senderDomain",
                "receiverDomain",
                "transfer",
                "ordering",
                "errorPolicy"
              ],
              "properties": {
                "edgeId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "mode": {
                  "enum": [
                    "stream",
                    "snapshot"
                  ]
                },
                "senderDomain": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "receiverDomain": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "transfer": {
                  "enum": [
                    "copy",
                    "move",
                    "borrow"
                  ]
                },
                "ordering": {
                  "enum": [
                    "fifo",
                    "latest"
                  ]
                },
                "errorPolicy": {
                  "enum": [
                    "propagate",
                    "reject-and-report",
                    "drop-and-report"
                  ]
                },
                "capacity": {
                  "type": "integer",
                  "minimum": 1
                },
                "overflow": {
                  "enum": [
                    "reject",
                    "drop-newest",
                    "drop-oldest",
                    "block"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "stream"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  "then": {
                    "required": [
                      "capacity",
                      "overflow"
                    ],
                    "properties": {
                      "ordering": {
                        "const": "fifo"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "mode": {
                        "const": "snapshot"
                      }
                    },
                    "required": [
                      "mode"
                    ]
                  },
                  "then": {
                    "properties": {
                      "ordering": {
                        "const": "latest"
                      }
                    },
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "capacity"
                          ]
                        },
                        {
                          "required": [
                            "overflow"
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ownerNodeId",
          "trigger",
          "initialState",
          "states",
          "transitions",
          "signals",
          "scheduling",
          "maxConcurrentInstances",
          "onLimit",
          "mailboxCapacity",
          "mailboxOverflow"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "ownerNodeId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "trigger": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "edgeId"
            ],
            "properties": {
              "kind": {
                "const": "data-arrival"
              },
              "edgeId": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
              }
            }
          },
          "initialState": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "states": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "terminal": {
                  "enum": [
                    "success",
                    "failure",
                    "cancelled"
                  ]
                }
              }
            }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "from",
                "to",
                "signal",
                "action"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "from": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "signal": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "action": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "none",
                        "dispatch",
                        "publish",
                        "request-cancel"
                      ]
                    },
                    "nodeId": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                    },
                    "operationId": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                    },
                    "edgeId": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "dispatch"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "then": {
                        "required": [
                          "nodeId",
                          "operationId"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "publish"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "then": {
                        "required": [
                          "edgeId"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "none"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "then": {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "nodeId"
                              ]
                            },
                            {
                              "required": [
                                "operationId"
                              ]
                            },
                            {
                              "required": [
                                "edgeId"
                              ]
                            }
                          ]
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "request-cancel"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "then": {
                        "not": {
                          "anyOf": [
                            {
                              "required": [
                                "nodeId"
                              ]
                            },
                            {
                              "required": [
                                "operationId"
                              ]
                            },
                            {
                              "required": [
                                "edgeId"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "scheduling": {
            "const": "per-instance-fifo"
          },
          "maxConcurrentInstances": {
            "type": "integer",
            "minimum": 1
          },
          "onLimit": {
            "const": "reject-and-report"
          },
          "mailboxCapacity": {
            "type": "integer",
            "minimum": 1
          },
          "mailboxOverflow": {
            "const": "reject-and-report"
          },
          "signals": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "source": {
                  "enum": [
                    "trigger",
                    "command-success",
                    "command-failure",
                    "control"
                  ]
                },
                "payloadType": {
                  "type": "string",
                  "minLength": 1
                },
                "nodeId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "operationId": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "source": {
                        "enum": [
                          "command-success",
                          "command-failure"
                        ]
                      }
                    },
                    "required": [
                      "source"
                    ]
                  },
                  "then": {
                    "required": [
                      "payloadType",
                      "nodeId",
                      "operationId"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "source": {
                        "const": "trigger"
                      }
                    },
                    "required": [
                      "source"
                    ]
                  },
                  "then": {
                    "required": [
                      "payloadType"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "nodeId"
                          ]
                        },
                        {
                          "required": [
                            "operationId"
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "source": {
                        "const": "control"
                      }
                    },
                    "required": [
                      "source"
                    ]
                  },
                  "then": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "payloadType"
                          ]
                        },
                        {
                          "required": [
                            "nodeId"
                          ]
                        },
                        {
                          "required": [
                            "operationId"
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

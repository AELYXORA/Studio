{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AUI Project Manifest — proposed",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "projectId",
    "revision",
    "targets",
    "packageDependencies",
    "nodes",
    "edges"
  ],
  "properties": {
    "format": {
      "const": "aui.project"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "triple",
          "execution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "triple": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "packageDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "packageId",
          "version"
        ],
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "typeRef": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "direction",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "object",
            "required": [
              "node"
            ],
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "required": [
              "node"
            ],
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1
              },
              "port": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

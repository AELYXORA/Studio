{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AELYXORA current unified public type, operation and component derived projection shapes — candidate",
  "description": "Closed derived meaning-bearing projections only. These are NOT authored package fields or approved public hashes. A successful JSON Schema validation does not prove unique normalized names, sorted sets, CR14 semantic rule-text correctness, complete verified TypeReference closure, source lock authority, native ABI or signer review.",
  "$defs": {
    "coreType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exportKind",
        "packageId",
        "typeId",
        "kind",
        "typeArity",
        "featureGate",
        "logicalTraits",
        "semanticModel",
        "semanticRules"
      ],
      "properties": {
        "exportKind": {
          "const": "type"
        },
        "packageId": {
          "const": "aui.core"
        },
        "typeId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "scalar",
            "immutable-value",
            "generic-value",
            "tagged-union",
            "opaque-runtime"
          ]
        },
        "typeArity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "featureGate": {
          "enum": [
            "D2-graph",
            "L0/L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "logicalTraits": {
          "$ref": "canonical-core-registry-candidate.schema.json#/properties/entries/items/properties/logicalTraits"
        },
        "semanticModel": {
          "$ref": "canonical-core-registry-candidate.schema.json#/properties/entries/items/properties/semanticModel"
        },
        "semanticRules": {
          "$ref": "canonical-core-registry-candidate.schema.json#/properties/entries/items/properties/semanticRules"
        }
      }
    },
    "nominalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exportKind",
        "packageId",
        "typeId",
        "kind",
        "fields"
      ],
      "properties": {
        "exportKind": {
          "const": "type"
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "typeId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "record"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "typeRef"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "typeRef": {
                "$ref": "aui-type-reference.schema.json"
              }
            }
          }
        }
      }
    },
    "nominalEnum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exportKind",
        "packageId",
        "typeId",
        "kind",
        "variants"
      ],
      "properties": {
        "exportKind": {
          "const": "type"
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "typeId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "enum"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "typeRef": {
                "$ref": "aui-type-reference.schema.json"
              }
            }
          }
        }
      }
    },
    "derivedGeneric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exportKind",
        "kind",
        "template",
        "arguments"
      ],
      "properties": {
        "exportKind": {
          "const": "type"
        },
        "kind": {
          "const": "generic"
        },
        "template": {
          "$ref": "aui-type-reference.schema.json#/$defs/nominal"
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "aui-type-reference.schema.json"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exportKind",
        "packageId",
        "componentTypeId",
        "operationId",
        "inputs",
        "successTypeRef",
        "failureTypeRef",
        "effects",
        "domain",
        "sideEffectClass",
        "retryPolicy",
        "requiredCapabilities",
        "declaredTargets"
      ],
      "properties": {
        "exportKind": {
          "const": "operation"
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "componentTypeId": {
          "type": "string",
          "minLength": 1
        },
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "typeRef"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "typeRef": {
                "$ref": "aui-type-reference.schema.json"
              }
            }
          }
        },
        "successTypeRef": {
          "$ref": "aui-type-reference.schema.json"
        },
        "failureTypeRef": {
          "$ref": "aui-type-reference.schema.json"
        },
        "effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "sideEffectClass": {
          "enum": [
            "none",
            "local-reversible",
            "external-nonreversible"
          ]
        },
        "retryPolicy": {
          "const": "never"
        },
        "requiredCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "declaredTargets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exportKind",
        "packageId",
        "typeId",
        "ports",
        "capabilities",
        "commands"
      ],
      "properties": {
        "exportKind": {
          "const": "component"
        },
        "packageId": {
          "type": "string",
          "minLength": 1
        },
        "typeId": {
          "type": "string",
          "minLength": 1
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "direction",
              "typeRef"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "in",
                  "out"
                ]
              },
              "typeRef": {
                "$ref": "aui-type-reference.schema.json"
              }
            }
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "operationContractDigest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "operationContractDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/coreType"
    },
    {
      "$ref": "#/$defs/nominalRecord"
    },
    {
      "$ref": "#/$defs/nominalEnum"
    },
    {
      "$ref": "#/$defs/derivedGeneric"
    },
    {
      "$ref": "#/$defs/operation"
    },
    {
      "$ref": "#/$defs/component"
    }
  ]
}

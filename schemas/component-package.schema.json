{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AUI Component Package — proposed",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "packageId",
    "packageVersion",
    "targets",
    "components",
    "dependencies",
    "testFixtures",
    "types"
  ],
  "properties": {
    "format": {
      "const": "aui.component-package"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "packageVersion": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "triple",
          "status"
        ],
        "properties": {
          "triple": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "supported",
              "unsupported",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "typeId",
          "contractVersion",
          "ports",
          "capabilities",
          "sources"
        ],
        "properties": {
          "typeId": {
            "type": "string",
            "minLength": 1
          },
          "contractVersion": {
            "type": "string",
            "minLength": 1
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "direction",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "target",
                "ownership"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "ownership": {
                  "enum": [
                    "human",
                    "generated",
                    "vendored"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "inputs",
                "resultType",
                "errorType",
                "effects",
                "domain"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "type"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "resultType": {
                  "type": "string",
                  "minLength": 1
                },
                "errorType": {
                  "type": "string",
                  "minLength": 1
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "domain": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array"
    },
    "testFixtures": {
      "type": "array"
    },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "typeId",
          "kind",
          "fields"
        ],
        "properties": {
          "typeId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "record"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

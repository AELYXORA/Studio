{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AELYXORA proposed v2 typed source to Graph binding supplement",
  "description": "Structural candidate only; graph and v2 typed component semantic projection, source approval, package resolution and native ABI remain unimplemented/unapproved. This supplement is separately hashed and pinned by preapproval proposal; it does not mutate the old link bundle schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "profile",
    "projectId",
    "graphRevision",
    "semanticGraphDigest",
    "sourceLinkBundleDigest",
    "lockDigest",
    "coreRegistryFingerprint",
    "typeExportSetDigest",
    "targetTriple",
    "abiLayoutDigest",
    "bindings"
  ],
  "properties": {
    "format": {
      "const": "aui.typed-source-graph-link"
    },
    "profile": {
      "const": "0.3-design-draft"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "graphRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semanticGraphDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceLinkBundleDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lockDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coreRegistryFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "typeExportSetDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetTriple": {
      "const": "x86_64-pc-windows-msvc"
    },
    "abiLayoutDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourcePath",
          "sourceSha256",
          "sourceSymbol",
          "graphNodeId",
          "operationId",
          "operationContractDigest",
          "domain",
          "effects",
          "requiredCapabilities",
          "inputs",
          "successTypeRef",
          "failureTypeRef",
          "taskOutcomeTypeRef"
        ],
        "properties": {
          "sourcePath": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sourceSymbol": {
            "type": "string",
            "minLength": 1
          },
          "graphNodeId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "operationId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "operationContractDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "typeRef"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "typeRef": {
                  "$ref": "aui-type-reference-v2.schema.json"
                }
              }
            }
          },
          "successTypeRef": {
            "$ref": "aui-type-reference-v2.schema.json"
          },
          "failureTypeRef": {
            "$ref": "aui-type-reference-v2.schema.json"
          },
          "taskOutcomeTypeRef": {
            "$ref": "aui-type-reference-v2.schema.json"
          }
        }
      }
    }
  }
}

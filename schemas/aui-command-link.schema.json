{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "D3 candidate derived AUI command link map",
  "description": "Not an authoritative graph edit or capability grant. Exact revision/source/package type matching required in the semantic linker. ApprovalStatus proposed is never ready for runtime execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "linkFormat",
    "projectId",
    "graphRevision",
    "semanticGraphDigest",
    "sourcePath",
    "sourceSha256",
    "coreRegistry",
    "approvalStatus",
    "commandBindings"
  ],
  "properties": {
    "format": {
      "const": "aui.command-link"
    },
    "linkFormat": {
      "const": "0.1-draft"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "graphRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semanticGraphDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "coreRegistry": {
      "const": "aui.core/0.1-draft"
    },
    "approvalStatus": {
      "const": "proposed"
    },
    "commandBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceSymbol",
          "graphNodeId",
          "exportedComponentTypeId",
          "exportedContractDigest",
          "operationId",
          "targetTriple",
          "domain",
          "effects",
          "inputs",
          "resultTypeId",
          "errorTypeId"
        ],
        "properties": {
          "sourceSymbol": {
            "type": "string",
            "minLength": 1
          },
          "graphNodeId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "exportedComponentTypeId": {
            "type": "string",
            "minLength": 1
          },
          "exportedContractDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "operationId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "targetTriple": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "typeId"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "typeId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "resultTypeId": {
            "type": "string",
            "minLength": 1
          },
          "errorTypeId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

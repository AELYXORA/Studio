{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed logical AUI core type registry inventory, not released export catalog",
  "description": "Documentary inventory only. Core TypeIDs, generic arities and proposed logical trait obligations can be checked; no valid exportedContractDigest or native layout is asserted. Exact D2 public-contract normalization and D4 layouts require separate architect approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "registryId",
    "status",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "aui.core-registry-proposal"
    },
    "registryId": {
      "const": "aui.core/extended-0.2-draft"
    },
    "status": {
      "const": "proposed-only"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "typeId",
          "kind",
          "typeArity",
          "featureGate",
          "logicalTraits",
          "nativeLayoutStatus"
        ],
        "properties": {
          "typeId": {
            "type": "string",
            "pattern": "^aui\\.core/[A-Za-z][A-Za-z0-9._-]*$"
          },
          "kind": {
            "enum": [
              "scalar",
              "immutable-value",
              "generic-value",
              "tagged-union",
              "opaque-runtime"
            ]
          },
          "typeArity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "featureGate": {
            "enum": [
              "L0/L1",
              "L2",
              "L3",
              "L4"
            ]
          },
          "logicalTraits": {
            "type": "array",
            "items": {
              "enum": [
                "Immutable",
                "Copy",
                "SendConditional",
                "Send",
                "Affine",
                "UIOwner",
                "Opaque"
              ]
            },
            "uniqueItems": true
          },
          "nativeLayoutStatus": {
            "const": "unapproved"
          },
          "semanticsOwner": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

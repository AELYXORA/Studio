{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AELYXORA Two-Slot HEAD Record - proposed D6 structural candidate",
  "description": "D6 design-only. Checksum and snapshot integrity are semantic/cryptographic, not JSON Schema assertions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "headFormat",
    "projectId",
    "epoch",
    "graphRevision",
    "semanticGraphDigest",
    "snapshotDigest",
    "predecessorEpoch",
    "checksum",
    "operationId"
  ],
  "properties": {
    "format": {
      "const": "aui.head-record"
    },
    "headFormat": {
      "const": "0.1-draft"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "graphRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semanticGraphDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshotDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "predecessorEpoch": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operationId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        }
      ]
    }
  }
}

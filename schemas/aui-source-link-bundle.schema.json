{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AELYXORA proposed AUI source-to-graph review bundle",
  "description": "Proposed structural shape ONLY; does not prove human approval, source owner authorization, export/ABI linkage or live OS/device capabilities. Bundle content hash and approval receipt are external and must be verified separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "bundleFormat",
    "projectId",
    "graphRevision",
    "semanticGraphDigest",
    "lockDigest",
    "coreRegistry",
    "sourceFiles",
    "bindings"
  ],
  "properties": {
    "format": {
      "const": "aui.source-link-bundle"
    },
    "bundleFormat": {
      "const": "0.2-design-draft"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "graphRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semanticGraphDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lockDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coreRegistry": {
      "type": "string",
      "minLength": 1
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sourceSha256",
          "languageProfile"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "languageProfile": {
            "enum": [
              "aui.source/l0/v1",
              "aui.source/l1/v1",
              "aui.source/l2-state/v1",
              "aui.source/l3-async/v1"
            ]
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "sourcePath",
          "sourceSymbol",
          "stableSymbolId",
          "graphNodeId",
          "exportedComponentTypeId",
          "exportedContractDigest",
          "targetTriple"
        ],
        "properties": {
          "kind": {
            "enum": [
              "command",
              "component-state"
            ]
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "sourceSymbol": {
            "type": "string",
            "minLength": 1
          },
          "stableSymbolId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "graphNodeId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "exportedComponentTypeId": {
            "type": "string",
            "minLength": 1
          },
          "exportedContractDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "targetTriple": {
            "type": "string",
            "minLength": 1
          },
          "operationId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "typeId"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "typeId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "resultTypeId": {
            "type": "string",
            "minLength": 1
          },
          "errorTypeId": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "command"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "operationId",
                "domain",
                "effects",
                "inputs",
                "resultTypeId",
                "errorTypeId"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "component-state"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "operationId"
                    ]
                  },
                  {
                    "required": [
                      "domain"
                    ]
                  },
                  {
                    "required": [
                      "effects"
                    ]
                  },
                  {
                    "required": [
                      "inputs"
                    ]
                  },
                  {
                    "required": [
                      "resultTypeId"
                    ]
                  },
                  {
                    "required": [
                      "errorTypeId"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AELYXORA typed v2 semanticGraphDigest source projection (strict structural draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "targets",
    "packageDependencies",
    "coreRegistryFingerprint",
    "typeExportSetDigest",
    "nodes",
    "edges",
    "workflows",
    "dataFlows",
    "profile"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "triple",
          "execution"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "triple": {
            "const": "x86_64-pc-windows-msvc"
          },
          "execution": {
            "const": "user"
          }
        }
      }
    },
    "packageDependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageId",
          "version"
        ],
        "properties": {
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coreRegistryFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "typeExportSetDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "packageId",
          "componentTypeId",
          "componentContractDigest",
          "targetId",
          "ports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "kind": {
            "const": "component-instance"
          },
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "componentTypeId": {
            "type": "string",
            "minLength": 1
          },
          "componentContractDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "targetId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "direction",
                "typeRef"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
                },
                "direction": {
                  "enum": [
                    "in",
                    "out"
                  ]
                },
                "typeRef": {
                  "$ref": "aui-type-reference-v2.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "kind": {
            "const": "data"
          },
          "from": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "port"
            ],
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
              },
              "port": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
              }
            }
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "port"
            ],
            "properties": {
              "node": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
              },
              "port": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
              }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "maxItems": 0
    },
    "dataFlows": {
      "type": "array",
      "maxItems": 0
    },
    "profile": {
      "const": "aui.semantic-graph/v2-typed-slice"
    }
  },
  "description": "Exact v2 typed slice semantic digest input after verified package/type/component/edge resolution. Source revision and labels prohibited. Arrays must also be semantically sorted and type identities validated before hashing."
}

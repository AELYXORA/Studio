// Historical illustrative D3+ source, NOT parser-ready in the strict L0/L1 profile.
// Uses positional .accessibilityLabel shorthand and unresolved AUI.Core imports,
// InspectError and Graph-linked Inspect provider. No compiler/run test has passed.
component SensorSummary(input reading: String) {
  event inspect: Event<Unit>;
  command Inspect() -> Result<Unit, InspectError> effects(state-write) on ui;
  on inspect(payload) {
    send Inspect();
  }
  VStack(spacing: 12) {
    Text(value: reading).accessibilityLabel("Sensor reading")
    Button(title: "Inspect").on(activated: inspect).accessibilityLabel("Inspect sensor")
  }
}

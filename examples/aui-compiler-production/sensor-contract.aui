import aui.core;

record Measurement {
  value: F64;
  valid: Bool;
}

enum SensorError {
  NoReading;
  DeviceUnavailable;
}

service SensorReader {
  command Read() -> Result<Measurement, SensorError>
    effects(device-read) on io-worker;
}

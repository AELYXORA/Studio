    "no-dispatch-unverified": "Only an unsupported claim exists",
    "untrusted-user": "User/source supplies a value with no trusted constructor",
    "wrong-generation": "Proof belongs to another UI owner or view generation",
    "contradicted-dispatch-proof": "Evidence shows provider dispatch might have occurred"

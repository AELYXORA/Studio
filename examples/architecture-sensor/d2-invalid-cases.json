{
  "format": "aui.validation-fixtures",
  "schemaVersion": "0.1-draft",
  "baseProject": "project.auiproj.json",
  "scope": "D2 graph behavior design candidate, expected semantic diagnostics; NOT executed",
  "cases": [
    {
      "id": "unknown-edge-kind",
      "mutation": {
        "path": "/edges/0/kind",
        "value": "connects"
      },
      "expected": "GRAPH_EDGE_KIND_UNKNOWN"
    },
    {
      "id": "wrong-channel-edge-kind",
      "mutation": {
        "path": "/dataFlows/0/channels/0/edgeId",
        "value": "e1"
      },
      "expected": "FLOW_EDGE_KIND"
    },
    {
      "id": "missing-channel-edge",
      "mutation": {
        "path": "/dataFlows/0/channels/0/edgeId",
        "value": "missing-edge"
      },
      "expected": "GRAPH_MISSING_EDGE"
    },
    {
      "id": "invalid-stream-capacity",
      "mutation": {
        "path": "/dataFlows/0/channels/0/capacity",
        "value": 0
      },
      "expected": "SCHEMA_INVALID",
      "note": "Structural schema rejects first; semantic FLOW_CAPACITY_INVALID applies to an unvalidated raw object, not the first validator output"
    },
    {
      "id": "cross-domain-borrow",
      "mutation": {
        "path": "/dataFlows/0/channels/1/transfer",
        "value": "borrow"
      },
      "expected": "FLOW_CROSS_DOMAIN_BORROW"
    },
    {
      "id": "workflow-bad-trigger-kind",
      "mutation": {
        "path": "/workflows/0/trigger/edgeId",
        "value": "e1"
      },
      "expected": "WORKFLOW_TRIGGER_KIND"
    },
    {
      "id": "workflow-missing-state",
      "mutation": {
        "path": "/workflows/0/transitions/1/to",
        "value": "unknown"
      },
      "expected": "WORKFLOW_STATE_UNKNOWN"
    },
    {
      "id": "workflow-missing-dispatch-node",
      "mutation": {
        "path": "/workflows/0/transitions/0/action/nodeId",
        "value": "missing"
      },
      "expected": "WORKFLOW_NODE_UNKNOWN"
    },
    {
      "id": "workflow-missing-provider",
      "mutation": {
        "path": "/workflows/0/transitions/0/action/operationId",
        "value": "Nonexistent"
      },
      "expected": "WORKFLOW_PROVIDER_UNRESOLVED"
    },
    {
      "id": "workflow-invalid-publish-edge",
      "mutation": {
        "path": "/workflows/0/transitions/1/action/edgeId",
        "value": "e3"
      },
      "expected": "WORKFLOW_PUBLISH_INVALID"
    },
    {
      "id": "workflow-missing-owner",
      "mutation": {
        "path": "/workflows/0/ownerNodeId",
        "value": "removed"
      },
      "expected": "WORKFLOW_NODE_UNKNOWN"
    },
    {
      "id": "snapshot-overflow-forbidden",
      "mutation": {
        "path": "/dataFlows/0/channels/1/overflow",
        "value": "reject"
      },
      "expected": "SCHEMA_INVALID",
      "note": "Structurally rejected because snapshot forbids overflow; not a runtime outcome"
    },
    {
      "id": "workflow-undeclared-signal",
      "mutation": {
        "path": "/workflows/0/transitions/1/signal",
        "value": "unexpected-result"
      },
      "expected": "WORKFLOW_SIGNAL_UNDECLARED"
    },
    {
      "id": "workflow-wrong-result-type",
      "mutation": {
        "path": "/workflows/0/signals/1/payloadType",
        "value": "example.sensor/RawSample"
      },
      "expected": "WORKFLOW_SIGNAL_TYPE"
    },
    {
      "id": "workflow-zero-mailbox",
      "mutation": {
        "path": "/workflows/0/mailboxCapacity",
        "value": 0
      },
      "expected": "SCHEMA_INVALID"
    },
    {
      "id": "workflow-zero-instances",
      "mutation": {
        "path": "/workflows/0/maxConcurrentInstances",
        "value": 0
      },
      "expected": "SCHEMA_INVALID"
    },
    {
      "id": "workflow-ambiguous-state-event",
      "mutations": [
        {
          "path": "/workflows/0/transitions/2/from",
          "value": "decoding"
        },
        {
          "path": "/workflows/0/transitions/2/signal",
          "value": "decoded"
        }
      ],
      "expected": "WORKFLOW_NONDETERMINISTIC",
      "note": "Duplicates the (decoding,decoded) pair with transition ok"
    },
    {
      "id": "workflow-wrong-control-signal",
      "mutation": {
        "path": "/workflows/0/signals/3/id",
        "value": "stop"
      },
      "expected": "WORKFLOW_SIGNAL_UNDECLARED",
      "note": "cancel transitions reference the old signal ID"
    },
    {
      "id": "workflow-nonterminal-cancel-confirmation-missing",
      "mutation": {
        "path": "/workflows/0/transitions/5/signal",
        "value": "decoded"
      },
      "expected": "WORKFLOW_NONDETERMINISTIC",
      "note": "When the declaration now duplicates the cancelling+decoded transition; no terminal cancellation proof"
    }
  ],
  "mutationSemantics": "Each case is independently applied to a deep copy of baseProject. A `mutation` object is one JSON Pointer replace/add; `mutations` is an ordered sequence of replacements applied atomically to one candidate. Expected diagnostics are specification, NOT observed tests.",
  "diagnosticPriority": "Structural JSON Schema errors before reference/semantic errors; then identities and references -> edge compatibility -> DataFlow policies -> Workflow checks -> capabilities. No runtime success claimed."
}

{
  "format": "aui.project",
  "schemaVersion": "0.1-draft",
  "projectId": "example.sensor-telemetry",
  "revision": 0,
  "targets": [
    {
      "id": "linux-arm64",
      "triple": "aarch64-unknown-linux-gnu",
      "execution": "user"
    }
  ],
  "packageDependencies": [
    {
      "packageId": "example.sensor",
      "version": "0.1.0"
    }
  ],
  "nodes": [
    {
      "id": "soc",
      "kind": "cpu",
      "label": "ARM64 SoC"
    },
    {
      "id": "bus",
      "kind": "bus",
      "label": "I2C Bus"
    },
    {
      "id": "sensor",
      "kind": "device",
      "label": "Sensor"
    },
    {
      "id": "driver",
      "kind": "driver",
      "label": "Sensor Driver",
      "typeRef": "example.sensor/driver",
      "target": "linux-arm64",
      "ports": [
        {
          "id": "sample",
          "direction": "out",
          "type": "example.sensor/RawSample"
        }
      ]
    },
    {
      "id": "decoder",
      "kind": "component",
      "label": "Decoder",
      "typeRef": "example.sensor/decoder",
      "ports": [
        {
          "id": "raw",
          "direction": "in",
          "type": "example.sensor/RawSample"
        },
        {
          "id": "reading",
          "direction": "out",
          "type": "example.sensor/Measurement"
        }
      ]
    },
    {
      "id": "app",
      "kind": "component",
      "label": "Telemetry App",
      "ports": [
        {
          "id": "reading",
          "direction": "in",
          "type": "example.sensor/Measurement"
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "e1",
      "kind": "hosts",
      "from": {
        "node": "soc"
      },
      "to": {
        "node": "bus"
      }
    },
    {
      "id": "e2",
      "kind": "hosts",
      "from": {
        "node": "bus"
      },
      "to": {
        "node": "sensor"
      }
    },
    {
      "id": "e3",
      "kind": "data-flow",
      "from": {
        "node": "driver",
        "port": "sample"
      },
      "to": {
        "node": "decoder",
        "port": "raw"
      }
    },
    {
      "id": "e4",
      "kind": "data-flow",
      "from": {
        "node": "decoder",
        "port": "reading"
      },
      "to": {
        "node": "app",
        "port": "reading"
      }
    }
  ],
  "dataFlows": [
    {
      "id": "sensor-telemetry",
      "channels": [
        {
          "edgeId": "e3",
          "mode": "stream",
          "senderDomain": "io-worker",
          "receiverDomain": "io-worker",
          "transfer": "copy",
          "ordering": "fifo",
          "errorPolicy": "propagate",
          "capacity": 32,
          "overflow": "reject"
        },
        {
          "edgeId": "e4",
          "mode": "snapshot",
          "senderDomain": "io-worker",
          "receiverDomain": "ui",
          "transfer": "copy",
          "ordering": "latest",
          "errorPolicy": "propagate"
        }
      ]
    }
  ],
  "workflows": [
    {
      "id": "sample-to-measurement",
      "ownerNodeId": "decoder",
      "trigger": {
        "kind": "data-arrival",
        "edgeId": "e3"
      },
      "initialState": "waiting",
      "states": [
        {
          "id": "waiting"
        },
        {
          "id": "decoding"
        },
        {
          "id": "cancelling"
        },
        {
          "id": "done",
          "terminal": "success"
        },
        {
          "id": "failed",
          "terminal": "failure"
        },
        {
          "id": "cancelled",
          "terminal": "cancelled"
        }
      ],
      "transitions": [
        {
          "id": "rx",
          "from": "waiting",
          "to": "decoding",
          "signal": "sample-arrived",
          "action": {
            "kind": "dispatch",
            "nodeId": "decoder",
            "operationId": "Decode"
          }
        },
        {
          "id": "ok",
          "from": "decoding",
          "to": "done",
          "signal": "decoded",
          "action": {
            "kind": "publish",
            "edgeId": "e4"
          }
        },
        {
          "id": "error",
          "from": "decoding",
          "to": "failed",
          "signal": "decode-error",
          "action": {
            "kind": "none"
          }
        },
        {
          "id": "cancel-wait",
          "from": "waiting",
          "to": "cancelled",
          "signal": "cancel",
          "action": {
            "kind": "none"
          }
        },
        {
          "id": "cancel-running",
          "from": "decoding",
          "to": "cancelling",
          "signal": "cancel",
          "action": {
            "kind": "request-cancel"
          }
        },
        {
          "id": "cancel-confirmed",
          "from": "cancelling",
          "to": "cancelled",
          "signal": "cancel-confirmed",
          "action": {
            "kind": "none"
          }
        },
        {
          "id": "completed-after-cancel",
          "from": "cancelling",
          "to": "done",
          "signal": "decoded",
          "action": {
            "kind": "publish",
            "edgeId": "e4"
          }
        },
        {
          "id": "failed-after-cancel",
          "from": "cancelling",
          "to": "failed",
          "signal": "decode-error",
          "action": {
            "kind": "none"
          }
        }
      ],
      "scheduling": "per-instance-fifo",
      "maxConcurrentInstances": 32,
      "onLimit": "reject-and-report",
      "mailboxCapacity": 8,
      "mailboxOverflow": "reject-and-report",
      "signals": [
        {
          "id": "sample-arrived",
          "source": "trigger",
          "payloadType": "example.sensor/RawSample"
        },
        {
          "id": "decoded",
          "source": "command-success",
          "nodeId": "decoder",
          "operationId": "Decode",
          "payloadType": "example.sensor/Measurement"
        },
        {
          "id": "decode-error",
          "source": "command-failure",
          "nodeId": "decoder",
          "operationId": "Decode",
          "payloadType": "example.sensor/DecodeError"
        },
        {
          "id": "cancel",
          "source": "control"
        },
        {
          "id": "cancel-confirmed",
          "source": "control"
        }
      ]
    }
  ]
}
